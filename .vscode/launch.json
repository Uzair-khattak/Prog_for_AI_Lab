{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug FastAPI (Q3 API)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["main:app", "--port", "8000", "--app-dir", "Q3/api"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Debug Streamlit app (Q3 UI)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "Q3/app/streamlit_app.py"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
